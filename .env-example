# Biến môi trường cho dev. Copy file này thành .env, điền key, rồi chạy:
#   uv run --env-file .env python -m datamate.run --data <train> --out runs/x --limit 5
# Không dùng khi nộp: predict.sh chạy vLLM local với giá trị mặc định trong datamate/config.py.

PYTHONUTF8=1

# LLM endpoint chuẩn OpenAI (ví dụ dưới là OpenRouter)
DATAMATE_LLM_BASE_URL=https://openrouter.ai/api/v1
DATAMATE_LLM_MODEL=qwen/qwen3-14b
DATAMATE_LLM_API_KEY=sk-or-your-key-here

# chat_template_kwargs chỉ vLLM hiểu; đặt 0 cho host khác
DATAMATE_TEMPLATE_KWARGS=0

# Giảm số request song song để tránh rate limit (mặc định 16)
DATAMATE_CONCURRENCY=4

# Cache câu trả lời của model (chỉ dev): chạy lại sau khi sửa ingest/semantics/kiểm tra đáp án thì những request
# có prompt không đổi không phải gọi lại model. Xoá thư mục khi đổi model.
DATAMATE_LLM_CACHE=runs/llm_cache

# Lặp nhanh khi dev: phiếu đầu tiên thắng, một lượt code. Bỏ dòng này (mặc định "balanced") khi đo điểm.
# DATAMATE_EFFORT=fast

# Tuỳ chọn (bỏ # để dùng), giá trị là mặc định
# DATAMATE_ATTEMPTS=3            # số lượt code agent tối đa cho một câu
# DATAMATE_TEMPLATES=1           # tầng 1: câu plain, không LLM
# DATAMATE_PLANNER=1             # tầng 2: LLM điền QUERY_SPEC
# DATAMATE_PLAN_THINKING=0
# DATAMATE_THINKING=1            # 1 | 0 | auto
# DATAMATE_FEWSHOT=3
# DATAMATE_EXAMPLES_HOLDOUT=0    # đặt 1 khi đo trên train với examples.jsonl
# DATAMATE_SANDBOX_GUARD=1
# DATAMATE_MAX_TOKENS=6144
# DATAMATE_DEADLINE_S=19800
# DATAMATE_WS=<thư mục cache workspace, mặc định %TEMP%/datamate_ws>
